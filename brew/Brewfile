# Core Brewfile — installed on every machine by ./install.sh, no prompt.
# Keep this to tools you genuinely want everywhere, including a locked-down
# work laptop. Anything more specific (security tooling, apps, extra
# runtimes) belongs in Brewfile.personal instead, which is opt-in.

brew "git"
brew "gh"
brew "jq"
brew "openjdk@21" # matches lib/10-path.zsh's JAVA_HOME detection

# Shell tooling — used by lib/11-completions.zsh and lib/20-aliases.zsh
brew "zoxide"    # smarter cd
brew "fzf"       # fuzzy finder (history, files/dirs)
brew "atuin"     # SQLite-backed searchable shell history (owns Ctrl+R)
brew "eza"       # ls replacement
brew "fd"        # find replacement
brew "ripgrep"   # grep replacement (binary is `rg`)
brew "bat"       # cat replacement
