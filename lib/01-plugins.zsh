# oh-my-zsh plugin list. install.sh clones the zsh-users/* plugins below
# into $ZSH_CUSTOM/plugins on any machine that doesn't have them yet.
#
# zsh-syntax-highlighting must stay last — it needs to wrap every other
# widget that's already been defined.
plugins=(
  git
  zsh-autosuggestions
  zsh-completions
  zsh-syntax-highlighting
)
